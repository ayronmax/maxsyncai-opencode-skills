	@exit 1

lint: lint-backend lint-frontend ## Todos os linters

lint-backend: ## Linter backend (substitua pelo comando real)
	@echo "TODO: implementar 'lint-backend' — comando {{LINTER_BACKEND}}"
	@exit 1

lint-frontend: ## Linter frontend (substitua pelo comando real)
	@echo "TODO: implementar 'lint-frontend' — comando {{LINTER_FRONTEND}}"
	@exit 1

check: lint test-backend-fast ## Validação rápida pré-push
	@echo "✓ make check"

format: ## Auto-formata (substitua pelo comando real)
